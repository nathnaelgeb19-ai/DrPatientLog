# Copy to .env for local use, or set as Environment Variables on the host
APP_ENV=production
SECRET_KEY=generate-a-long-random-string-here
SESSION_COOKIE_SECURE=1
TZ=Africa/Addis_Ababa
DATA_DIR=/data
DAILY_REPORT_TIME=19:00
MONTHLY_REPORT_TIME=19:00

# Clinic branding (optional — can also be set in Settings UI after login)
CLINIC_NAME=Your Clinic Name
CLINIC_NAME_SHORT=Your Clinic

# Optional email recovery
APP_BASE_URL=https://your-app.onrender.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
